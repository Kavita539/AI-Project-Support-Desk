# Web (apps/web/.env.local) - anon key only
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:8000

# API (apps/api/.env) - never expose to the web
DATABASE_URL=
SUPABASE_URL=   # project must use asymmetric JWT signing keys (Auth > JWT Keys)
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=   # API only, never in the web app; required when LLM_PROVIDER=gemini
# Required, no default (the API refuses to boot without it): fake for local dev and CI, gemini needs GEMINI_API_KEY
LLM_PROVIDER=fake
# Optional Gemini settings (defaults shown)
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite
# LLM_TIMEOUT_SECONDS=30
# Comma-separated origins of the deployed web app (browser calls are blocked otherwise)
CORS_ORIGINS=http://localhost:5173
