# Web (apps/web/.env.local) - anon key only
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:8000

# API (apps/api/.env) - never expose to the web
DATABASE_URL=
SUPABASE_URL=   # project must use asymmetric JWT signing keys (Auth > JWT Keys)
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=gemini   # gemini | fake
# Comma-separated origins of the deployed web app (browser calls are blocked otherwise)
CORS_ORIGINS=http://localhost:5173
